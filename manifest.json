{
  "manifest_version": 3,
  "name": "JSON to CSV Converter",
  "version": "1.0",
  "description": "Convierte archivos JSON (array de objetos) a formato CSV",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon.png",
      "48": "images/icon.png",
      "128": "images/icon.png"
    }
  },
  "permissions": [
    "downloads"
  ],
  "icons": {
    "16": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  }
}
